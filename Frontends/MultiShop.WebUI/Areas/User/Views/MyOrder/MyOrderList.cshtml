@model List<ResultOrderingByUserIdDto>
@{
    ViewData["Title"] = "Siparişlerim";
    ViewData["v1"] = "Anasayfa";
    ViewData["v2"] = "Siparişler";
    Layout = "~/Areas/User/Views/UserLayout/Index.cshtml";
    int count = 0;
}

    <div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Basic Table</h4>
                <p class="card-description">
                    Add class <code>.table</code>
                </p>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Toplam Fiyat</th>
                                <th>Sipariş Tarihi</th>
                                <th>Sipariş Detayları</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                count++;
                                <tr>
                                    <th>@count</th>
                                    <td>@item.TotalPrice</td>
                                    <td>@(((DateTime)item.OrderDate).ToString("dd-MMM-yyyy"))</td>
                                    <td><a href="#" class="btn btn-warning">Sipariş Detayları</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    </div>
