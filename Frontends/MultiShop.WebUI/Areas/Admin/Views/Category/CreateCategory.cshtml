@model CreateCategoryDto
@{
    ViewData["Title"] = "Kategori Ekle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    var allFilters = ViewBag.AllFilters as List<ResultFilterDto> ?? new List<ResultFilterDto>();
    var filterGroups = allFilters.GroupBy(x => x.FilterTitle).ToList();
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-10">
            <div class="chart-box">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="m-0 font-weight-bold text-dark"><i class="fa fa-plus-circle text-primary mr-2"></i> Yeni Kategori Ekle</h4>
                    <a href="/Admin/Category/Index" class="btn btn-secondary btn-sm"><i class="fa fa-arrow-left mr-1"></i> Listeye Dön</a>
                </div>

                <form method="post" enctype="multipart/form-data">
                    <div class="form-group mb-3">
                        <label class="font-weight-bold">Kategori Adı <span class="text-danger">*</span> : </label>
                        <input type="text" asp-for="CategoryName" class="form-control" required placeholder="Kategori Adı">
                    </div>

                    <!-- Görsel Yükleme Paneli -->
                    <div class="panel panel-default p-3 bg-light rounded border mb-3" style="padding:15px; margin-bottom:20px;">
                        <h5 class="font-weight-bold text-dark mb-3"><i class="fa fa-image text-primary mr-1"></i> Kategori Görseli</h5>
                        <div class="row align-items-center">
                            <div class="col-md-5 form-group">
                                <label>Görsel Dosyası Yükle (Bilgisayardan):</label>
                                <input type="file" name="imageFile" accept="image/*" class="form-control" onchange="previewFile(this, 'catImgBox', 'catUrlInput')" />
                                <small class="text-muted">Görsel doğrudan sunucuya yüklenecektir.</small>
                            </div>
                            <div class="col-md-5 form-group">
                                <label>Veya Görsel URL'si / Galeriden:</label>
                                <div class="input-group">
                                    <input type="text" asp-for="ImageUrl" id="catUrlInput" class="form-control" placeholder="https://..." oninput="previewUrl(this.value, 'catImgBox')" />
                                    <span class="input-group-btn">
                                        <button type="button" class="btn btn-info font-weight-bold" onclick="openMediaPicker('catUrlInput', 'catImgBox')">
                                            <i class="fa fa-folder-open mr-1"></i> Galeriden Seç
                                        </button>
                                    </span>
                                </div>
                            </div>
                            <div class="col-md-2 text-center">
                                <div id="catImgBox" style="width:70px; height:70px; border:2px dashed #ccc; border-radius:6px; display:flex; align-items:center; justify-content:center; overflow:hidden; background:#fff;">
                                    <span class="text-muted small">Yok</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr style="margin: 20px 0;" />
                    <h5 class="font-weight-bold text-dark"><i class="fa fa-filter text-primary mr-1"></i> Kategoriye Filtre Ata</h5>
                    <p class="text-muted small mb-2">Önce filtre başlığını seçiniz, ardından kategoriye atanacak seçenekleri işaretleyiniz.</p>

                    <div class="form-group">
                        <label><strong>Filtre Grubu Seçiniz:</strong></label>
                        <select id="filterGroupSelect" class="form-control" style="max-width:350px;">
                            <option value="">--- Bir Filtre Grubu Seçiniz ---</option>
                            @foreach (var group in filterGroups)
                            {
                                <option value="@("fg_" + Math.Abs(group.Key.GetHashCode()))">@group.Key (@group.Count() seçenek)</option>
                            }
                        </select>
                    </div>

                    <div id="filterGroupsContainer" style="margin-top: 15px;">
                        @foreach (var group in filterGroups)
                        {
                            var gId = "fg_" + Math.Abs(group.Key.GetHashCode());
                            <div class="filter-group-panel" id="@gId" style="display:none; padding:15px; background:#f8f9fa; border:1px solid #e9ecef; border-radius:5px; margin-bottom:15px;">
                                <h6 style="color:#007bff; margin-bottom:10px;"><strong>@group.Key Seçenekleri:</strong></h6>
                                <div class="row">
                                    @foreach (var filter in group)
                                    {
                                        <div class="col-md-3 col-sm-4 col-xs-6">
                                            <label><input type="checkbox" name="selectedFilterIds" value="@filter.FilterId" class="filter-chk" data-title="@group.Key" data-name="@filter.FilterName" /> @filter.FilterName</label>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <div id="selectedFiltersSummary" style="margin-top:15px; margin-bottom:20px; display:none;">
                        <label><strong>Kategori İçin Seçili Filtreler:</strong></label>
                        <div id="selectedBadgeList"></div>
                    </div>

                    <div class="mt-4 pt-3 border-top">
                        <button class="btn btn-primary font-weight-bold px-4 py-2" type="submit"><i class="fa fa-save mr-1"></i> Kategori Ekle</button>
                        <a href="/Admin/Category/Index" class="btn btn-secondary px-4 py-2 ml-2">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<script>
    function previewFile(input, boxId, urlInputId) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById(boxId).innerHTML = '<img src="' + e.target.result + '" style="width:100%; height:100%; object-fit:contain;" />';
            };
            reader.readAsDataURL(input.files[0]);
            if (urlInputId) document.getElementById(urlInputId).value = '';
        }
    }
    function previewUrl(url, boxId) {
        if (url && url.length > 5) {
            document.getElementById(boxId).innerHTML = '<img src="' + url + '" style="width:100%; height:100%; object-fit:contain;" onerror="this.parentElement.innerHTML=\'<span class=\\\'text-danger small\\\'>Hata</span>\'" />';
        } else {
            document.getElementById(boxId).innerHTML = '<span class="text-muted small">Yok</span>';
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        var groupSelect = document.getElementById('filterGroupSelect');
        var groupPanels = document.querySelectorAll('.filter-group-panel');
        var chks = document.querySelectorAll('.filter-chk');
        var summaryDiv = document.getElementById('selectedFiltersSummary');
        var badgeList = document.getElementById('selectedBadgeList');

        if (groupSelect) {
            groupSelect.addEventListener('change', function() {
                var val = this.value;
                groupPanels.forEach(function(panel) { panel.style.display = (panel.id === val) ? 'block' : 'none'; });
            });
        }

        function updateSummary() {
            if (!badgeList) return;
            badgeList.innerHTML = '';
            var selected = document.querySelectorAll('.filter-chk:checked');
            if (selected.length > 0) {
                summaryDiv.style.display = 'block';
                selected.forEach(function(item) {
                    var span = document.createElement('span');
                    span.className = 'badge badge-info';
                    span.style.cssText = 'font-size:12px; margin-right:5px; margin-bottom:5px; background:#17a2b8; color:#fff; padding:5px 8px; display:inline-block;';
                    span.innerText = item.getAttribute('data-title') + ': ' + item.getAttribute('data-name');
                    badgeList.appendChild(span);
                });
            } else { summaryDiv.style.display = 'none'; }
        }
        chks.forEach(function(chk) { chk.addEventListener('change', updateSummary); });
        updateSummary();
    });
</script>

@await Html.PartialAsync("~/Areas/Admin/Views/Shared/_MediaPickerModalPartial.cshtml")
