@model CreateFilterDto
@{
    ViewData["Title"] = "Yeni Filtre Ekle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="row">
    <div class="col-md-8">
        <div class="chart-box">
            <h4>Yeni Filtre Ekle</h4>
            <form method="post">
                <div class="form-group">
                    <label>Filtre Grubu / Başlığı (Örn: Renk, Beden, Marka, Materyal)</label>
                    <input type="text" asp-for="FilterTitle" class="form-control" required placeholder="Filtre başlığı giriniz..." />
                </div>
                <div class="form-group">
                    <label>Filtre Değeri (Örn: Siyah, XL, Pamuk, Nike)</label>
                    <input type="text" asp-for="FilterName" class="form-control" required placeholder="Filtre değeri giriniz..." />
                </div>
                <button type="submit" class="btn btn-success"><i class="fa fa-save"></i> Kaydet</button>
                <a href="/Admin/Filter/Index" class="btn btn-secondary">İptal</a>
            </form>
        </div>
    </div>
</div>
