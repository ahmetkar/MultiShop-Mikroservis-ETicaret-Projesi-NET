@model UpdateDiscountCouponDto
@{
    ViewData["Title"] = "Kupon Güncelle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    var productList = ViewBag.ProductList as List<SelectListItem> ?? new List<SelectListItem>();
}

<div class="row">
    <div class="col-md-8">
        <div class="chart-box">
            <h4>Kupon / İndirim Güncelle</h4>
            <form method="post">
                <input type="hidden" asp-for="CouponId" />
                <div class="form-group">
                    <label>Kupon Kodu</label>
                    <input type="text" asp-for="Code" class="form-control" required style="text-transform:uppercase;" />
                </div>
                <div class="form-group">
                    <label>İndirim Oranı (%)</label>
                    <input type="number" asp-for="Rate" class="form-control" min="1" max="100" required />
                </div>
                <div class="form-group">
                    <label>Kapsam / Ürün Seçimi</label>
                    <select asp-for="ProductId" asp-items="productList" class="form-control">
                    </select>
                </div>
                <div class="form-group">
                    <label>Son Geçerlilik Tarihi</label>
                    <input type="datetime-local" asp-for="ValidDate" class="form-control" value="@Model.ValidDate.ToString("yyyy-MM-ddTHH:mm")" required />
                </div>
                <div class="form-group form-check">
                    <input type="checkbox" asp-for="IsActive" class="form-check-input" id="isActiveCheck" />
                    <label class="form-check-label" for="isActiveCheck">Kupon Aktif</label>
                </div>
                <button type="submit" class="btn btn-warning"><i class="fa fa-pencil"></i> Güncelle</button>
                <a href="/Admin/Coupon/Index" class="btn btn-secondary">İptal</a>
            </form>
        </div>
    </div>
</div>
