@model CreateCargoCompanyDto
@{
    ViewData["Title"] = "Yeni Kargo Şirketi Ekle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-8">
            <div class="chart-box">
                <h4>Yeni Kargo Şirketi Ekle</h4>
                <div class="bs-example">
                    <form method="post">
                        <div class="form-group">
                            <label>Kargo Şirket Adı : </label>
                            <input type="text" asp-for="CargoCompanyName" class="form-control" required placeholder="Örn: Yurtiçi Kargo">
                        </div>
                        <div class="form-group">
                            <label>Kargo Ücreti (₺) : </label>
                            <input type="number" step="0.01" asp-for="CargoPrice" class="form-control" required value="35" placeholder="Kargo Ücreti">
                        </div>
                        <br />
                        <button class="btn btn-primary" type="submit"><i class="fa fa-save"></i> Kaydet</button>
                        <a href="/Admin/Cargo/CargoCompanyList" class="btn btn-secondary">İptal</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
