@using MultiShop.DtoLayer.OrderDtos.OrderOrderingDtos
@model List<ResultCargoOperationDto>
@{
    ViewData["Title"] = "Kargo Süreçleri";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    var details = ViewBag.Details as List<ResultCargoDetailDto> ?? new List<ResultCargoDetailDto>();
    var companies = ViewBag.Companies as List<ResultCargoCompanyDto> ?? new List<ResultCargoCompanyDto>();
    var orders = ViewBag.Orders as List<ResultOrderingByUserIdDto> ?? new List<ResultOrderingByUserIdDto>();

    var activeCargos = Model?.Where(x => {
        var ord = orders.FirstOrDefault(o => o.OrderingId == x.OrderingId);
        return ord == null || (ord.Status != OrderStatus.CargoApproved && ord.Status != OrderStatus.Completed && ord.Status != OrderStatus.Cancelled);
    }).OrderByDescending(x => x.OperationDate).ToList() ?? new List<ResultCargoOperationDto>();

    var approvedCargos = Model?.Where(x => {
        var ord = orders.FirstOrDefault(o => o.OrderingId == x.OrderingId);
        return ord != null && ord.Status == OrderStatus.CargoApproved;
    }).OrderByDescending(x => x.OperationDate).ToList() ?? new List<ResultCargoOperationDto>();

    var deliveredCargos = Model?.Where(x => {
        var ord = orders.FirstOrDefault(o => o.OrderingId == x.OrderingId);
        return ord != null && ord.Status == OrderStatus.Completed;
    }).OrderByDescending(x => x.OperationDate).ToList() ?? new List<ResultCargoOperationDto>();

    int c1 = 0; int c2 = 0; int c3 = 0;
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                <h4><i class="fa fa-truck text-primary"></i> Kargo Süreç Yönetimi</h4>
                <p class="text-muted small mb-3">Tüm siparişlerin lojistik, kargo onay ve teslimat aşamalarını bu panelden yönetebilirsiniz.</p>
                
                <ul class="nav nav-tabs" style="margin-bottom:20px;">
                    <li class="active">
                        <a href="#tab1" data-toggle="tab">
                            <i class="fa fa-clock text-warning mr-1"></i> Devam Eden Kargolar (@activeCargos.Count)
                        </a>
                    </li>
                    <li>
                        <a href="#tab2" data-toggle="tab">
                            <i class="fa fa-check-circle text-info mr-1"></i> Onaylanan Kargolar (@approvedCargos.Count)
                        </a>
                    </li>
                    <li>
                        <a href="#tab3" data-toggle="tab">
                            <i class="fa fa-check-double text-success mr-1"></i> Teslim Edilen Kargolar (@deliveredCargos.Count)
                        </a>
                    </li>
                </ul>
                <div class="tab-content">
                    <!-- Tab 1: Devam Eden Kargolar -->
                    <div class="tab-pane active" id="tab1">
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped table-hover">
                                <thead class="thead-light">
                                    <tr>
                                        <th>#</th>
                                        <th>Barkod / Takip No</th>
                                        <th>Sipariş No</th>
                                        <th>Kargo Şirketi</th>
                                        <th>İşlem Tarihi</th>
                                        <th>Sipariş Durumu</th>
                                        <th>İşlem (Kargo Onayla)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (activeCargos.Count == 0)
                                    {
                                        <tr><td colspan="7" class="text-center text-muted p-4">Devam eden kargo kaydı bulunmamaktadır.</td></tr>
                                    }
                                    @foreach (var item in activeCargos)
                                    {
                                        c1++;
                                        var det = details.FirstOrDefault(d => d.CargoDetailId == item.CargoDetailId);
                                        var comp = det != null ? companies.FirstOrDefault(c => c.CargoCompanyId == det.CargoCompanyId) : null;
                                        var ord = orders.FirstOrDefault(o => o.OrderingId == item.OrderingId);
                                        <tr>
                                            <td>@c1</td>
                                            <td><span class="badge badge-info">@(det?.Barcode ?? "TR-KRG-" + item.CargoOperationId)</span></td>
                                            <td><strong>#@item.OrderingId</strong></td>
                                            <td>@(comp?.CargoCompanyName ?? "MultiShop Kargo")</td>
                                            <td>@item.OperationDate.ToString("dd.MM.yyyy HH:mm")</td>
                                            <td><span class="badge badge-warning">Kargoda / Hazırlanıyor</span></td>
                                            <td>
                                                <a href="/Admin/Cargo/ConfirmDelivery/@item.CargoOperationId" class="btn btn-primary btn-sm font-weight-bold" onclick="return confirm('Kargo onaylanarak sipariş durumu CargoApproved yapılsın mı?');">
                                                    <i class="fa fa-check mr-1"></i> Kargoyu Onayla (CargoApproved)
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <!-- Tab 2: Onaylanan Kargolar -->
                    <div class="tab-pane" id="tab2">
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped table-hover">
                                <thead class="thead-light">
                                    <tr>
                                        <th>#</th>
                                        <th>Barkod / Takip No</th>
                                        <th>Sipariş No</th>
                                        <th>Kargo Şirketi</th>
                                        <th>İşlem Tarihi</th>
                                        <th>Sipariş Durumu</th>
                                        <th>Açıklama</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (approvedCargos.Count == 0)
                                    {
                                        <tr><td colspan="7" class="text-center text-muted p-4">Onaylanan kargo kaydı bulunmamaktadır.</td></tr>
                                    }
                                    @foreach (var item in approvedCargos)
                                    {
                                        c2++;
                                        var det = details.FirstOrDefault(d => d.CargoDetailId == item.CargoDetailId);
                                        var comp = det != null ? companies.FirstOrDefault(c => c.CargoCompanyId == det.CargoCompanyId) : null;
                                        var ord = orders.FirstOrDefault(o => o.OrderingId == item.OrderingId);
                                        <tr>
                                            <td>@c2</td>
                                            <td><span class="badge badge-secondary">@(det?.Barcode ?? "TR-KRG-" + item.CargoOperationId)</span></td>
                                            <td><strong>#@item.OrderingId</strong></td>
                                            <td>@(comp?.CargoCompanyName ?? "MultiShop Kargo")</td>
                                            <td>@item.OperationDate.ToString("dd.MM.yyyy HH:mm")</td>
                                            <td><span class="badge badge-info">Kargo Onaylandı (Dağıtımda)</span></td>
                                            <td><small class="text-muted">Müşteri teslimatı bekleniyor</small></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Tab 3: Teslim Edilen Kargolar -->
                    <div class="tab-pane" id="tab3">
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped table-hover">
                                <thead class="thead-light">
                                    <tr>
                                        <th>#</th>
                                        <th>Barkod / Takip No</th>
                                        <th>Sipariş No</th>
                                        <th>Kargo Şirketi</th>
                                        <th>Teslim Tarihi</th>
                                        <th>Sipariş Durumu</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (deliveredCargos.Count == 0)
                                    {
                                        <tr><td colspan="6" class="text-center text-muted p-4">Teslim edilen kargo kaydı bulunmamaktadır.</td></tr>
                                    }
                                    @foreach (var item in deliveredCargos)
                                    {
                                        c3++;
                                        var det = details.FirstOrDefault(d => d.CargoDetailId == item.CargoDetailId);
                                        var comp = det != null ? companies.FirstOrDefault(c => c.CargoCompanyId == det.CargoCompanyId) : null;
                                        var ord = orders.FirstOrDefault(o => o.OrderingId == item.OrderingId);
                                        <tr>
                                            <td>@c3</td>
                                            <td><span class="badge badge-success">@(det?.Barcode ?? "TR-KRG-" + item.CargoOperationId)</span></td>
                                            <td><strong>#@item.OrderingId</strong></td>
                                            <td>@(comp?.CargoCompanyName ?? "MultiShop Kargo")</td>
                                            <td>@item.OperationDate.ToString("dd.MM.yyyy HH:mm")</td>
                                            <td><span class="badge badge-success"><i class="fa fa-check-double mr-1"></i> Teslim Edildi</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

