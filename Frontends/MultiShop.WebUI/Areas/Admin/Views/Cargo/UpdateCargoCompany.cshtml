@model UpdateCargoCompanyDto
@{
    ViewData["Title"] = "Kargo Şirketi Güncelle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-8">
            <div class="chart-box">
                <h4>Kargo Şirketi Güncelle</h4>
                <div class="bs-example">
                    <form method="post" action="/Admin/Cargo/UpdateCargoCompany/@Model.CargoCompanyId">
                        <input type="hidden" asp-for="CargoCompanyId" />
                        <div class="form-group">
                            <label>Kargo Şirket Adı : </label>
                            <input type="text" asp-for="CargoCompanyName" class="form-control" required placeholder="Şirket isim :">
                        </div>
                        <div class="form-group">
                            <label>Kargo Ücreti (₺) : </label>
                            <input type="number" step="0.01" asp-for="CargoPrice" class="form-control" required placeholder="Kargo Ücreti">
                        </div>
                        <br />
                        <button class="btn btn-primary" type="submit"><i class="fa fa-pencil"></i> Güncelle</button>
                        <a href="/Admin/Cargo/CargoCompanyList" class="btn btn-secondary">İptal</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
