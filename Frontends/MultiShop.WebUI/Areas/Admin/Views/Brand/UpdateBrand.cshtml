@model UpdateBrandDto
@{
    ViewData["Title"] = "Marka Güncelle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-8">
            <div class="chart-box">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="m-0 font-weight-bold text-dark"><i class="fa fa-edit text-primary mr-2"></i> Marka Güncelle</h4>
                    <a href="/Admin/Brand/Index" class="btn btn-secondary btn-sm"><i class="fa fa-arrow-left mr-1"></i> Listeye Dön</a>
                </div>

                <form method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="BrandId" />

                    <div class="form-group mb-3">
                        <label class="font-weight-bold">Marka Adı <span class="text-danger">*</span> : </label>
                        <input type="text" asp-for="BrandName" class="form-control" required placeholder="Marka isim :">
                    </div>

                    <div class="panel panel-default p-3 bg-light rounded border mb-3" style="padding:15px; margin-bottom:20px;">
                        <h5 class="font-weight-bold text-dark mb-3"><i class="fa fa-image text-primary mr-1"></i> Marka Logosu / Görseli</h5>
                        <div class="row align-items-center">
                            <div class="col-md-6 form-group">
                                <label>Yeni Görsel Dosyası Yükle:</label>
                                <input type="file" name="imageFile" accept="image/*" class="form-control" onchange="previewFile(this, 'brandImgBox', 'brandUrlInput')" />
                                <small class="text-muted">Farklı bir logo yüklemek için dosya seçiniz.</small>
                            </div>
                            <div class="col-md-4 form-group">
                                <label>Veya Görsel URL'si:</label>
                                <input type="text" asp-for="ImageUrl" id="brandUrlInput" class="form-control" placeholder="https://..." oninput="previewUrl(this.value, 'brandImgBox')" />
                            </div>
                            <div class="col-md-2 text-center">
                                <div id="brandImgBox" style="width:70px; height:70px; border:2px dashed #ccc; border-radius:6px; display:flex; align-items:center; justify-content:center; overflow:hidden; background:#fff;">
                                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                    {
                                        <img src="@Model.ImageUrl" style="width:100%; height:100%; object-fit:contain;" onerror="this.parentElement.innerHTML='<span class=\'text-danger small\'>Hata</span>'" />
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Yok</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <button class="btn btn-primary font-weight-bold px-4 py-2" type="submit"><i class="fa fa-save mr-1"></i> Değişiklikleri Güncelle</button>
                    <a href="/Admin/Brand/Index" class="btn btn-secondary px-4 py-2 ml-2">İptal</a>
                </form>
            </div>
        </div>
    </div>
</section>

<script>
    function previewFile(input, boxId, urlInputId) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById(boxId).innerHTML = '<img src="' + e.target.result + '" style="width:100%; height:100%; object-fit:contain;" />';
            };
            reader.readAsDataURL(input.files[0]);
            if (urlInputId) document.getElementById(urlInputId).value = '';
        }
    }
    function previewUrl(url, boxId) {
        if (url && url.length > 5) {
            document.getElementById(boxId).innerHTML = '<img src="' + url + '" style="width:100%; height:100%; object-fit:contain;" onerror="this.parentElement.innerHTML=\'<span class=\\\'text-danger small\\\'>Hata</span>\'" />';
        } else {
            document.getElementById(boxId).innerHTML = '<span class="text-muted small">Yok</span>';
        }
    }
</script>
@await Html.PartialAsync("~/Areas/Admin/Views/Shared/_MediaPickerModalPartial.cshtml")
