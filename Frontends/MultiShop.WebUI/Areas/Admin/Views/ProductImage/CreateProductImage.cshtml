@model CreateProductImageDto
@{
    ViewData["Title"] = "Yeni Ürün Görselleri Ekle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    var productList = ViewBag.ProductList as List<SelectListItem> ?? new List<SelectListItem>();
}

<style>
    .preview-card {
        border: 2px dashed #dee2e6;
        border-radius: 8px;
        background: #f8f9fa;
        height: 150px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        margin-top: 8px;
    }
    .preview-card img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }
</style>

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-10">
            <div class="chart-box">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4><i class="fa fa-plus-circle text-primary mr-2"></i> Yeni Ürün Görsel Seti Ekle</h4>
                    <a href="/Admin/ProductImage/Index" class="btn btn-secondary btn-sm"><i class="fa fa-arrow-left mr-1"></i> Listeye Dön</a>
                </div>

                <form method="post" action="/Admin/ProductImage/CreateProductImage">
                    <div class="form-group mb-4">
                        <label class="font-weight-bold">İlişkili Ürün <span class="text-danger">*</span></label>
                        @Html.DropDownListFor(x => x.ProductId, productList, "--- Lütfen Ürün Seçiniz ---", new { @class = "form-control", @required = "required" })
                    </div>

                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label class="font-weight-bold">Görsel 1 URL (Ana Görsel) <span class="text-danger">*</span></label>
                            <input type="url" asp-for="Image1" id="img1Input" class="form-control" placeholder="https://example.com/image1.jpg" required oninput="updatePreview('img1Input', 'img1Preview')" />
                            <div class="preview-card" id="img1Preview">
                                <span class="text-muted small"><i class="fa fa-image mr-1"></i> Görsel 1 Önizleme</span>
                            </div>
                        </div>

                        <div class="col-md-6 form-group">
                            <label class="font-weight-bold">Görsel 2 URL</label>
                            <input type="url" asp-for="Image2" id="img2Input" class="form-control" placeholder="https://example.com/image2.jpg" oninput="updatePreview('img2Input', 'img2Preview')" />
                            <div class="preview-card" id="img2Preview">
                                <span class="text-muted small"><i class="fa fa-image mr-1"></i> Görsel 2 Önizleme</span>
                            </div>
                        </div>

                        <div class="col-md-6 form-group">
                            <label class="font-weight-bold">Görsel 3 URL</label>
                            <input type="url" asp-for="Image3" id="img3Input" class="form-control" placeholder="https://example.com/image3.jpg" oninput="updatePreview('img3Input', 'img3Preview')" />
                            <div class="preview-card" id="img3Preview">
                                <span class="text-muted small"><i class="fa fa-image mr-1"></i> Görsel 3 Önizleme</span>
                            </div>
                        </div>

                        <div class="col-md-6 form-group">
                            <label class="font-weight-bold">Görsel 4 URL</label>
                            <input type="url" asp-for="Image4" id="img4Input" class="form-control" placeholder="https://example.com/image4.jpg" oninput="updatePreview('img4Input', 'img4Preview')" />
                            <div class="preview-card" id="img4Preview">
                                <span class="text-muted small"><i class="fa fa-image mr-1"></i> Görsel 4 Önizleme</span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top">
                        <button type="submit" class="btn btn-primary font-weight-bold px-4 py-2">
                            <i class="fa fa-save mr-1"></i> Görsel Setini Kaydet
                        </button>
                        <a href="/Admin/ProductImage/Index" class="btn btn-secondary px-4 py-2 ml-2">Vazgeç</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<script>
    function updatePreview(inputId, previewId) {
        var url = document.getElementById(inputId).value;
        var container = document.getElementById(previewId);
        if (url && url.length > 5) {
            container.innerHTML = '<img src="' + url + '" onerror="this.parentElement.innerHTML=\'<span class=\\\'text-danger small\\\'>Geçersiz Görsel URL</span>\'" />';
        } else {
            container.innerHTML = '<span class="text-muted small"><i class="fa fa-image mr-1"></i> Önizleme Yok</span>';
        }
    }
</script>
