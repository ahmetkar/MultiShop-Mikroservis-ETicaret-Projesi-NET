@model UpdateOfferDiscountDto
@{
    ViewData["Title"] = "İndirim Teklifi Güncelle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    var products = ViewBag.Products as List<ResultProductDto> ?? new List<ResultProductDto>();
    var selectedIds = Model.ProductIds ?? new List<string>();
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-10">
            <div class="chart-box">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="m-0 font-weight-bold text-dark"><i class="fa fa-edit text-primary mr-2"></i> Özel İndirim Teklifi Güncelle</h4>
                    <a href="/Admin/OfferDiscount/Index" class="btn btn-secondary btn-sm"><i class="fa fa-arrow-left mr-1"></i> Listeye Dön</a>
                </div>

                <div class="bs-example">
                    <form method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="OfferDiscountId" />

                        <div class="form-group mb-3">
                            <label class="font-weight-bold">Özel Teklif Başlığı <span class="text-danger">*</span> : </label>
                            <input type="text" asp-for="Title" class="form-control" required placeholder="Teklif Başlığı">
                        </div>
                        <div class="form-group mb-3">
                            <label class="font-weight-bold">Özel Teklif Alt Başlığı : </label>
                            <input type="text" asp-for="Subtitle" class="form-control" placeholder="Teklif Alt Başlığı">
                        </div>
                        <div class="form-group mb-3">
                            <label class="font-weight-bold">Buton Yazısı : </label>
                            <input type="text" asp-for="ButtonTitle" class="form-control" placeholder="Örn: Şimdi Alışveriş Yap">
                        </div>

                        <!-- Görsel Yükleme Paneli -->
                        <div class="panel panel-default p-3 bg-light rounded border mb-3" style="padding:15px; margin-bottom:20px;">
                            <h5 class="font-weight-bold text-dark mb-3"><i class="fa fa-image text-primary mr-1"></i> Teklif Görseli</h5>
                            <div class="row align-items-center">
                                <div class="col-md-5 form-group">
                                    <label>Yeni Görsel Yükle (Bilgisayardan):</label>
                                    <input type="file" name="imageFile" accept="image/*" class="form-control" onchange="previewFile(this, 'offerImgBox', 'offerUrlInput')" />
                                    <small class="text-muted">Farklı bir görsel seçebilirsiniz.</small>
                                </div>
                                <div class="col-md-5 form-group">
                                    <label>Veya Görsel URL'si / Galeriden:</label>
                                    <div class="input-group">
                                        <input type="text" asp-for="ImageUrl" id="offerUrlInput" class="form-control" placeholder="https://..." oninput="previewUrl(this.value, 'offerImgBox')" />
                                        <span class="input-group-btn">
                                            <button type="button" class="btn btn-info font-weight-bold" onclick="openMediaPicker('offerUrlInput', 'offerImgBox')">
                                                <i class="fa fa-folder-open mr-1"></i> Galeriden Seç
                                            </button>
                                        </span>
                                    </div>
                                </div>
                                <div class="col-md-2 text-center">
                                    <div id="offerImgBox" style="width:100px; height:60px; border:2px dashed #ccc; border-radius:6px; display:flex; align-items:center; justify-content:center; overflow:hidden; background:#fff;">
                                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                        {
                                            <img src="@Model.ImageUrl" style="width:100%; height:100%; object-fit:cover;" onerror="this.parentElement.innerHTML='<span class=\'text-danger small\'>Geçersiz</span>'" />
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Önizleme Yok</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <hr style="margin: 20px 0;" />
                        <h5 class="font-weight-bold text-dark"><i class="fa fa-shopping-bag text-primary mr-1"></i> Bu İndirim Teklifi ile İlişkilendirilen Ürünler</h5>
                        <p class="text-muted small mb-2">Kullanıcılar ana sayfada bu teklif görseline veya butonuna tıkladığında seçtiğiniz bu ürünler listelenecektir.</p>

                        <div style="max-height: 250px; overflow-y: auto; background: #f8f9fa; border: 1px solid #e9ecef; border-radius: 5px; padding: 15px;">
                            <div class="row">
                                @foreach (var p in products)
                                {
                                    var isChecked = selectedIds.Contains(p.ProductId);
                                    <div class="col-md-4 col-sm-6 mb-2">
                                        <div class="checkbox" style="margin: 4px 0;">
                                            <label style="font-weight: 500;">
                                                <input type="checkbox" name="selectedProductIds" value="@p.ProductId" @(isChecked ? "checked" : "")>
                                                @p.ProductName (@p.ProductPrice ₺)
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="mt-4 pt-3 border-top">
                            <button class="btn btn-primary font-weight-bold px-4 py-2" type="submit"><i class="fa fa-save mr-1"></i> Değişiklikleri Güncelle</button>
                            <a href="/Admin/OfferDiscount/Index" class="btn btn-secondary px-4 py-2 ml-2">İptal</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    function previewFile(input, boxId, urlInputId) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById(boxId).innerHTML = '<img src="' + e.target.result + '" style="width:100%; height:100%; object-fit:cover;" />';
            };
            reader.readAsDataURL(input.files[0]);
            if (urlInputId) document.getElementById(urlInputId).value = '';
        }
    }
    function previewUrl(url, boxId) {
        if (url && url.length > 5) {
            document.getElementById(boxId).innerHTML = '<img src="' + url + '" style="width:100%; height:100%; object-fit:cover;" onerror="this.parentElement.innerHTML=\'<span class=\\\'text-danger small\\\'>Geçersiz</span>\'" />';
        } else {
            document.getElementById(boxId).innerHTML = '<span class="text-muted small">Önizleme Yok</span>';
        }
    }
</script>

@await Html.PartialAsync("~/Areas/Admin/Views/Shared/_MediaPickerModalPartial.cshtml")
