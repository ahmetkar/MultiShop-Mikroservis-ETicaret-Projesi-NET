@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/UILayout/_UILayout.cshtml";
}


<!-- Checkout Start -->
<div class="container-fluid">

    <div class="row px-xl-5">
       
        @if (ViewBag.AdressCount > 0)
        {
            
            @await Component.InvokeAsync("_AdressListViewComponentPartial")
          
            
        }else
        {
            
            @await Component.InvokeAsync("_AddAdressViewComponentPartial")
            
        }

        
        


    </div>
</div>
  

<!-- Checkout End -->
