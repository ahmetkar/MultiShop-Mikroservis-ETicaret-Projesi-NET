@model int
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/UILayout/_UILayout.cshtml";
}


<!-- Cart Start -->
<div class="container-fluid">
    <div class="row px-xl-5">
        @await Component.InvokeAsync("_ShoppingCartProductListComponentPartial")




        @*@await Component.InvokeAsync("_ShoppingCartDiscountCouponComponentPartial") *@ 
        
        <div class="col-lg-4">
        @await Html.PartialAsync("~/Views/Discount/ConfirmDiscountCoupon.cshtml")


        <h5 class="section-title position-relative text-uppercase mb-3"><span class="bg-secondary pr-3">Sipariş Özeti</span></h5>
        <div class="bg-light p-30 mb-5">
                @if(Model > 0)
                {
                    <div class="border-bottom pb-2">
                        <div class="d-flex justify-content-between mb-3">
                            <h6>Toplam Ürün Fiyatı</h6>
                            <h6>@ViewBag.TotalPriceWithoutKDV ₺</h6>
                        </div>
                        <div class="d-flex justify-content-between">
                            <h6 class="font-weight-medium">KDV</h6>
                            <h6 class="font-weight-medium">@ViewBag.KDV ₺</h6>
                        </div>
                        @if (ViewBag.DiscountRate != null)
                        {
                            <div class="d-flex justify-content-between">
                                <h6 class="font-weight-medium">İndirim Oranı</h6>
                                <h6 class="font-weight-medium">% @ViewBag.DiscountRate</h6>
                            </div>

                            <div class="d-flex justify-content-between">
                                <h6 class="font-weight-medium">İndirim Kodu</h6>
                                <h6 class="font-weight-medium">@ViewBag.DiscountCode</h6>
                            </div>
                        }
                    </div>
                    <div class="pt-2">
                        <div class="d-flex justify-content-between mt-2">
                            <h5>Toplam</h5>

                            @if (ViewBag != null)
                            {
                               
                                @if(ViewBag.DiscountRate != null)
                                {
                                    <h5 style="text-decoration:line-through;">@ViewBag.TotalPriceWithoutDiscount ₺</h5>
                                }
                                <h5>@ViewBag.TotalPrice ₺</h5>
                            }
                            else
                            {
                                <h5>@ViewBag.TotalPrice ₺</h5>
                            }
                        </div>
                       
                        <a href="/Order" class="btn btn-block btn-primary font-weight-bold my-3 py-3">Sipariş Ver</a>
                        
                      
                    </div>
                }else
                {
                    <p>Sonraki aşamaya geçmek için ürün ekleyin.</p>
                }

        </div>
    </div>
        <!---->
    </div>
</div>
<!-- Cart End -->
