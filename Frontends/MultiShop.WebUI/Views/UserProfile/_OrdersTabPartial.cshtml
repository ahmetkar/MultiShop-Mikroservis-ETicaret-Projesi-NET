@using MultiShop.DtoLayer.OrderDtos.OrderOrderingDtos
@{
    var userOrders = ViewBag.UserOrders as List<ResultOrderingByUserIdDto> ?? new List<ResultOrderingByUserIdDto>();
    var allDetails = ViewBag.AllOrderDetails as List<ResultOrderDetailDto> ?? new List<ResultOrderDetailDto>();
    var cargoOperations = ViewBag.CargoOperations as List<ResultCargoOperationDto> ?? new List<ResultCargoOperationDto>();
    var cargoDetails = ViewBag.CargoDetails as List<ResultCargoDetailDto> ?? new List<ResultCargoDetailDto>();
    var cargoCompanies = ViewBag.CargoCompanies as List<MultiShop.DtoLayer.CargoDtos.CargoCompanyDtos.ResultCargoCompanyDto> ?? new List<MultiShop.DtoLayer.CargoDtos.CargoCompanyDtos.ResultCargoCompanyDto>();

    string GetStatusText(OrderStatus status)
    {
        if ((int)status == 0) return "Yarıda Kalan Sipariş";
        return status switch
        {
            OrderStatus.OrderCreated => "Sipariş Alındı",
            OrderStatus.OrderNotCreated => "Oluşturulamadı",
            OrderStatus.PendingPayment => "Ödeme Bekleniyor",
            OrderStatus.PaymentCompleted => "Hazırlanıyor",
            OrderStatus.CargoCreated => "Kargoya Verildi",
            OrderStatus.CargoApproved => "Kargo Onaylandı",
            OrderStatus.Completed => "Teslim Edildi",
            OrderStatus.Cancelled => "İptal Edildi",
            OrderStatus.PaymentFailed => "Ödeme Başarısız",
            OrderStatus.CargoFailed => "Kargo Hatası",
            _ => "Sipariş Alındı"
        };
    }

    string GetStatusBadgeClass(OrderStatus status)
    {
        if ((int)status == 0) return "badge-warning";
        return status switch
        {
            OrderStatus.Completed => "badge-success",
            OrderStatus.Cancelled or OrderStatus.PaymentFailed or OrderStatus.CargoFailed or OrderStatus.OrderNotCreated => "badge-danger",
            OrderStatus.CargoApproved or OrderStatus.CargoCreated => "badge-info",
            OrderStatus.PendingPayment or OrderStatus.PaymentCompleted => "badge-warning",
            _ => "badge-secondary"
        };
    }

    int GetTimelineStep(OrderStatus status)
    {
        return status switch
        {
            OrderStatus.Cancelled or OrderStatus.PaymentFailed or OrderStatus.CargoFailed or OrderStatus.OrderNotCreated => -1,
            OrderStatus.Completed => 4,
            OrderStatus.CargoApproved or OrderStatus.CargoCreated => 3,
            OrderStatus.PaymentCompleted => 2,
            _ => 1
        };
    }
}

<style>
    .order-timeline {
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
        margin: 20px 10px 15px 10px;
    }
    .order-timeline::before {
        content: '';
        position: absolute;
        top: 18px;
        left: 5%;
        right: 5%;
        height: 4px;
        background: #e9ecef;
        z-index: 1;
    }
    .timeline-step {
        position: relative;
        z-index: 2;
        text-align: center;
        flex: 1;
    }
    .timeline-step .circle {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #fff;
        border: 3px solid #dee2e6;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        color: #adb5bd;
        margin-bottom: 6px;
    }
    .timeline-step.completed .circle {
        background: #28a745;
        border-color: #28a745;
        color: #fff;
    }
    .timeline-step.active .circle {
        background: #ffc107;
        border-color: #ffc107;
        color: #212529;
    }
    .timeline-step .label {
        font-size: 12px;
        font-weight: 600;
        color: #6c757d;
        display: block;
    }
    .timeline-step.completed .label,
    .timeline-step.active .label {
        color: #212529;
    }
</style>

<div class="bg-light p-4 rounded border mb-30">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="font-weight-bold text-dark m-0"><i class="fa fa-shopping-bag text-primary mr-2"></i> Siparişlerim</h4>
        <span class="badge badge-dark p-2">Toplam @userOrders.Count Sipariş</span>
    </div>

    @if (userOrders.Count == 0)
    {
        <div class="text-center py-5 bg-white rounded border">
            <i class="fa fa-shopping-cart fa-3x text-muted mb-3"></i>
            <h5 class="text-dark font-weight-bold">Henüz siparişiniz bulunmamaktadır.</h5>
            <p class="text-muted small">MultiShop'un geniş ürün yelpazesinden dilediğiniz ürünü sepete ekleyerek sipariş verebilirsiniz.</p>
            <a href="/" class="btn btn-primary font-weight-bold px-4 py-2 mt-2">Alışverişe Başla</a>
        </div>
    }
    else
    {
        <div class="accordion" id="ordersAccordion">
            @foreach (var order in userOrders.OrderByDescending(x => x.OrderDate))
            {
                var items = allDetails.Where(d => d.OrderingId == order.OrderingId).ToList();
                var op = cargoOperations.FirstOrDefault(o => o.OrderingId == order.OrderingId);
                var det = op != null ? cargoDetails.FirstOrDefault(d => d.CargoDetailId == op.CargoDetailId) : null;
                var comp = det != null ? cargoCompanies.FirstOrDefault(c => c.CargoCompanyId == det.CargoCompanyId) : null;
                decimal subtotal = items.Sum(x => x.ProductTotalPrice);
                decimal cargoFee = order.TotalPrice > subtotal ? (order.TotalPrice - subtotal) : 35m;
                var currentStep = GetTimelineStep(order.Status);
                var statusText = GetStatusText(order.Status);
                var badgeClass = GetStatusBadgeClass(order.Status);
                bool isIncompleteOrder = (int)order.Status == 0;

                @if (isIncompleteOrder)
                {
                    <div class="card mb-3 border border-warning rounded shadow-sm bg-white">
                        <div class="card-body p-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center">
                            <div class="mb-3 mb-md-0">
                                <div class="d-flex align-items-center mb-1">
                                    <h6 class="mb-0 font-weight-bold text-dark mr-3">Sipariş No: #@order.OrderingId</h6>
                                    <span class="badge @badgeClass px-2 py-1" style="font-size:12px;">@statusText</span>
                                </div>
                                <div class="text-muted small mt-1">
                                    <i class="fa fa-calendar-alt mr-1"></i> @order.OrderDate.ToString("dd.MM.yyyy HH:mm") •
                                    <i class="fa fa-box mr-1"></i> @items.Count Ürün •
                                    <strong class="text-dark">₺@order.TotalPrice.ToString("N2")</strong>
                                    <span class="text-warning ml-2 font-weight-bold"><i class="fa fa-exclamation-triangle mr-1"></i> Ödeme adımı tamamlanmadı</span>
                                </div>
                            </div>
                            <div class="d-flex align-items-center">
                                <a href="/UserProfile/ContinuePayment/@order.OrderingId" class="btn btn-warning font-weight-bold btn-sm px-3 shadow-sm mr-2 text-dark">
                                    <i class="fa fa-credit-card mr-1"></i> Siparişe Devam Et
                                </a>
                                <a href="/UserProfile/CancelOrder/@order.OrderingId" class="btn btn-outline-danger btn-sm px-3" onclick="return confirm('Bu yarıda kalan siparişi iptal etmek istediğinizden emin misiniz?');">
                                    <i class="fa fa-times mr-1"></i> İptal Et
                                </a>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card mb-3 border rounded shadow-sm">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3" style="cursor:pointer;" data-toggle="collapse" data-target="#col-@order.OrderingId">
                            <div>
                                <div class="d-flex align-items-center mb-1">
                                    <h6 class="mb-0 font-weight-bold text-dark mr-3">Sipariş No: #@order.OrderingId</h6>
                                    <span class="badge @badgeClass px-2 py-1" style="font-size:12px;">@statusText</span>
                                </div>
                                <small class="text-muted">
                                    <i class="fa fa-calendar-alt mr-1"></i> @order.OrderDate.ToString("dd.MM.yyyy HH:mm") •
                                    <i class="fa fa-box mr-1"></i> @items.Count Ürün •
                                    <strong class="text-dark">₺@order.TotalPrice.ToString("N2")</strong>
                                </small>
                            </div>
                            <div>
                                <button class="btn btn-sm btn-outline-secondary">Detaylar <i class="fa fa-chevron-down ml-1"></i></button>
                            </div>
                        </div>
                        <div id="col-@order.OrderingId" class="collapse" data-parent="#ordersAccordion">
                            <div class="card-body bg-light border-top">
                                <!-- Kargo Timeline -->
                                <div class="bg-white p-3 rounded border mb-3">
                                    <h6 class="font-weight-bold text-dark mb-2"><i class="fa fa-truck text-primary mr-2"></i> Kargo & Teslimat Süreci</h6>
                                    @if (order.Status == OrderStatus.Cancelled || order.Status == OrderStatus.PaymentFailed || order.Status == OrderStatus.CargoFailed)
                                    {
                                        <div class="alert alert-danger mb-0 text-center py-2">
                                            <i class="fa fa-times-circle mr-1"></i> Bu sipariş iptal edilmiştir.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="order-timeline">
                                            <div class="timeline-step @(currentStep >= 1 ? (currentStep == 1 ? "active" : "completed") : "")">
                                                <div class="circle"><i class="fa @(currentStep > 1 ? "fa-check" : "fa-clipboard-check")"></i></div>
                                                <span class="label">Sipariş Alındı</span>
                                            </div>
                                            <div class="timeline-step @(currentStep >= 2 ? (currentStep == 2 ? "active" : "completed") : "")">
                                                <div class="circle"><i class="fa @(currentStep > 2 ? "fa-check" : "fa-boxes")"></i></div>
                                                <span class="label">Hazırlanıyor</span>
                                            </div>
                                            <div class="timeline-step @(currentStep >= 3 ? (currentStep == 3 ? "active" : "completed") : "")">
                                                <div class="circle"><i class="fa @(currentStep > 3 ? "fa-check" : "fa-truck")"></i></div>
                                                <span class="label">Kargoda</span>
                                            </div>
                                            <div class="timeline-step @(currentStep >= 4 ? "completed" : "")">
                                                <div class="circle"><i class="fa fa-home"></i></div>
                                                <span class="label">Teslim Edildi</span>
                                            </div>
                                        </div>
                                        <div class="row bg-light p-2 rounded mt-2 text-muted small mx-0">
                                            <div class="col-md-6 mb-1 mb-md-0"><strong>Kargo Firması:</strong> @(comp?.CargoCompanyName ?? "MultiShop Kargo")</div>
                                            <div class="col-md-6 text-md-right"><strong>Takip No:</strong> <span class="badge badge-secondary">@(!string.IsNullOrEmpty(det?.Barcode) ? det.Barcode : ("TR-" + order.OrderingId + "-KRG"))</span></div>
                                        </div>
                                    }
                                </div>

                                <!-- Sipariş Detay Tablosu -->
                                <div class="table-responsive bg-white rounded border mb-3">
                                    <table class="table table-sm table-hover mb-0">
                                        <thead class="thead-light">
                                            <tr>
                                                <th>Ürün Adı</th>
                                                <th>Varyant / Özellik</th>
                                                <th class="text-center">Adet</th>
                                                <th class="text-right">Birim Fiyat</th>
                                                <th class="text-right">Toplam Fiyat</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var it in items)
                                            {
                                                <tr>
                                                    <td class="font-weight-bold">@it.ProductName</td>
                                                    <td>@(string.IsNullOrEmpty(it.ProductFilters) ? "Standart" : it.ProductFilters)</td>
                                                    <td class="text-center"><span class="badge badge-light border">@it.ProductAmount Adet</span></td>
                                                    <td class="text-right">₺@it.ProductPrice.ToString("N2")</td>
                                                    <td class="text-right font-weight-bold text-dark">₺@it.ProductTotalPrice.ToString("N2")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                <!-- Alt Bilgi ve Butonlar -->
                                <div class="d-flex flex-column flex-md-row justify-content-between align-items-center bg-white p-3 rounded border">
                                    <div class="mb-2 mb-md-0 text-muted small">
                                        Ara Toplam: <strong>₺@subtotal.ToString("N2")</strong> |
                                        Kargo: <strong>₺@cargoFee.ToString("N2")</strong> |
                                        <span class="text-dark" style="font-size:14px;">Toplam: <strong class="text-primary">₺@order.TotalPrice.ToString("N2")</strong></span>
                                    </div>
                                    <div>
                                        @if (order.Status != OrderStatus.Completed && order.Status != OrderStatus.Cancelled)
                                        {
                                            <a href="/UserProfile/ConfirmDelivery/@order.OrderingId" class="btn btn-success btn-sm px-3 mr-2" onclick="return confirm('Siparişinizi teslim aldığınızı onaylıyor musunuz?');">
                                                <i class="fa fa-check mr-1"></i> Siparişim Teslim Edildi
                                            </a>
                                            <a href="/UserProfile/CancelOrder/@order.OrderingId" class="btn btn-outline-danger btn-sm px-3" onclick="return confirm('Siparişinizi iptal etmek istediğinizden emin misiniz?');">
                                                <i class="fa fa-times mr-1"></i> Siparişi İptal Et
                                            </a>
                                        }
                                        else if (order.Status == OrderStatus.Completed)
                                        {
                                            <span class="badge badge-success p-2"><i class="fa fa-check-double mr-1"></i> Bu sipariş başarıyla tamamlandı</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    }
</div>

