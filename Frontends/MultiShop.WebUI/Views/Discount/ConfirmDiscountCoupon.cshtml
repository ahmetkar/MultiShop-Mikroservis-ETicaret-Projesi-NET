
    <form class="mb-30" asp-controller="Discount" asp-action="ConfirmDiscountCoupon" method="post">
        <div class="input-group">
            <input type="text" name="code" class="form-control border-0 p-4" placeholder="Kupon Kodu">
            <div class="input-group-append">
                <button class="btn btn-primary">Kuponu Uygula</button><br />
                
            </div>
            @if (ViewBag.code != null)
            {
                
                <div class="input-group-append">
                    <br /><br />
                    <h5>Kod : @ViewBag.code</h5>    
                </div>
            }
        </div>
    </form>
    