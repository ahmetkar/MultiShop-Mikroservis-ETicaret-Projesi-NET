
@{
    ViewData["Title"] = "Ürün Detayları";
    Layout = "~/Views/UILayout/_UILayout.cshtml";
}


<!-- Shop Detail Start -->
<div class="container-fluid pb-5">
    <div class="row px-xl-5">
        @await Component.InvokeAsync("_ProductDetailImageSliderComponentPartial", new { id = ViewBag.id })

        @await Component.InvokeAsync("_ProductDetailFeatureComponentPartial",new {id = ViewBag.id})

    </div>

    <div class="row px-xl-5">
        <div class="col">
            <div class="bg-light p-30">
                <div class="nav nav-tabs mb-4">
                    <a class="nav-item nav-link text-dark active" data-toggle="tab" href="#tab-pane-1">Ürün Açıklaması</a>
                    <a class="nav-item nav-link text-dark" data-toggle="tab" href="#tab-pane-2">Ürün Bilgileri</a>
                    <a class="nav-item nav-link text-dark" data-toggle="tab" href="#tab-pane-3">Yorumlar (@(ViewBag.commentCount ?? 0))</a>
                </div>
                <div class="tab-content">
                    <div class="tab-pane fade show active" id="tab-pane-1">
                        @await Component.InvokeAsync("_ProductDetailDescriptionComponentPartial",new {id = ViewBag.id})
                    </div>

                    <div class="tab-pane fade" id="tab-pane-2">
                        @await Component.InvokeAsync("_ProductDetailInformationComponentPartial", new { id = ViewBag.id })
                    </div>

                    <div class="tab-pane fade" id="tab-pane-3">
                        <div class="row">
                        @await Component.InvokeAsync("_ProductDetailReviewComponentPartial",new {id = ViewBag.id})
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
<!-- Shop Detail End -->

<!-- Products Start -->
<div class="container-fluid py-5">
    <h2 class="section-title position-relative text-uppercase mx-xl-5 mb-4"><span class="bg-secondary pr-3">Benzer Ürünler</span></h2>
    <div class="row px-xl-5">
        <div class="col">
            <div class="owl-carousel related-carousel">
                <div class="product-item bg-light">
                    <div class="product-img position-relative overflow-hidden">
                        <img class="img-fluid w-100" src="~/multishop/img/product-1.jpg" alt="">
                        <div class="product-action">
                            <a class="btn btn-outline-dark btn-square" href=""><i class="fa fa-shopping-cart"></i></a>
                            <a class="btn btn-outline-dark btn-square" href=""><i class="fa fa-sync-alt"></i></a>
                            <a class="btn btn-outline-dark btn-square" href=""><i class="fa fa-search"></i></a>
                        </div>
                    </div>
                    <div class="text-center py-4">
                        <a class="h6 text-decoration-none text-truncate" href="">MultiShop Ürün</a>
                        <div class="d-flex align-items-center justify-content-center mt-2">
                            <h5>₺150.00</h5>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Products End -->
