
@{
    ViewData["Title"] = "Ürün Listesi";
    Layout = "~/Views/UILayout/_UILayout.cshtml";
    var filterIds = ViewBag.FilterIds as List<string> ?? new List<string>();
    int currentPage = ViewBag.CurrentPage as int? ?? 1;
}

<!-- Shop Start -->
<div class="container-fluid">
    <div class="row px-xl-5">
        <!-- Shop Sidebar Start -->
        <div class="col-lg-3 col-md-4">
             @await Component.InvokeAsync("_ProductsFilterListComponentPartial", new { categoryid = ViewBag.i, selectedFilterIds = filterIds })
        </div>
        <!-- Shop Sidebar End -->
        <!-- Shop Product Start -->
        <div class="col-lg-9 col-md-8">
            <div class="row pb-3">
                @await Component.InvokeAsync("_ProductListGetProductCountComponentPartial", new { categoryid = ViewBag.i, filterIds = filterIds })

                @await Component.InvokeAsync("_ProductListComponentPartial", new { categoryid = ViewBag.i, filterIds = filterIds, page = currentPage })

                @await Component.InvokeAsync("_ProductListPaginationComponentPartial", new { categoryid = ViewBag.i, filterIds = filterIds, currentPage = currentPage })

            </div>
        </div>
        <!-- Shop Product End -->
    </div>
</div>
<!-- Shop End -->
