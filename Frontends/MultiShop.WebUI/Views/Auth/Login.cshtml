@model SignInDto
@{
    ViewData["Title"] = "Giriş Yap";
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Giriş Yap - MultiShop</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/ovioadmin/bootstrap/css/bootstrap.min.css">

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css?family=Poppins:300,400,500,600,700" rel="stylesheet">

    <!-- Template style -->
    <link rel="stylesheet" href="~/ovioadmin/dist/css/style.css">
    <link rel="stylesheet" href="~/ovioadmin/pages/et-line-font/et-line-font.css">
    <link rel="stylesheet" href="~/ovioadmin/pages/font-awesome/css/font-awesome.min.css">
</head>

<body class="body-bg-color">
    <div class="wrapper">
        <div class="form-body">
           
            <form action="" method="post" class="col-form" novalidate>
                <div class="col-logo"><a href="/"><img width="300px" height="60px" alt="MultiShop Logo" src="~/img/logos/MULTISHOPPNG.png"></a></div>
                
                @if (Context.Request.Query.ContainsKey("registered") || TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success" style="padding: 12px 15px; margin-bottom: 15px; border-radius: 4px; font-weight: 500; background-color: #d4edda; color: #155724; border: 1px solid #c3e6cb; font-size: 13px;">
                        <i class="fa fa-check-circle mr-1"></i> @(TempData["SuccessMessage"] ?? "Kayıt işleminiz başarıyla tamamlandı. Şimdi giriş yapabilirsiniz.")
                    </div>
                }

                @if (Context.Request.Query.ContainsKey("reasonorder"))
                {
                    <div class="alert alert-warning" style="padding: 12px 15px; margin-bottom: 15px; border-radius: 4px; font-weight: 500; background-color: #fff3cd; color: #856404; border: 1px solid #ffeeba; font-size: 13px;">
                        <i class="fa fa-info-circle mr-1"></i> Sipariş işlemlerini tamamlayabilmek için lütfen giriş yapınız.
                    </div>
                }

                <header>Giriş Yap</header>

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                {
                    <div asp-validation-summary="ModelOnly" class="text-danger" style="padding: 12px 15px; margin-bottom: 15px; background-color: #fff0f0; border-left: 4px solid #ff4d4d; border-radius: 4px; font-weight: 500; font-size: 13px;"></div>
                }

                <fieldset>
                    <section>
                        <div class="form-group has-feedback">
                            <label class="control-label">Kullanıcı Adı <span class="text-danger">*</span></label>
                            <input asp-for="Username" class="form-control" placeholder="Kullanıcı adınız" type="text" required>
                            <span class="fa fa-user form-control-feedback" aria-hidden="true"></span>
                            <span asp-validation-for="Username" class="text-danger" style="font-size: 12px;"></span>
                        </div>
                    </section>
                    <section>
                        <div class="form-group has-feedback">
                            <label class="control-label">Şifre <span class="text-danger">*</span></label>
                            <input asp-for="Password" class="form-control" placeholder="Şifreniz" type="password" required>
                            <span class="fa fa-lock form-control-feedback" aria-hidden="true"></span>
                            <span asp-validation-for="Password" class="text-danger" style="font-size: 12px;"></span>
                        </div>
                    </section>
                    <section>
                        <div class="row">
                            <div class="col-md-6 checkbox">
                                <a href="javascript:void(0);" onclick="alert('Şifre sıfırlama için lütfen sistem yöneticisi ile iletişime geçiniz.');">Şifremi Unuttum</a>
                            </div>
                            <div class="col-md-6 text-right">
                                <label class="checkbox">
                                    <input asp-for="RememberMe" checked="" type="checkbox">
                                    <i></i> Beni Hatırla
                                </label>
                            </div>
                        </div>
                    </section>
                </fieldset>
                <footer class="text-right">
                    <button type="submit" class="btn btn-info pull-right">Giriş Yap</button>
                    <a href="/Register/Index" class="button button-secondary">Kayıt Ol</a>
                </footer>
            </form>
        </div>
    </div>

    <!-- jQuery -->
    <script src="~/ovioadmin/dist/js/jquery.min.js"></script>
    <script src="~/ovioadmin/bootstrap/js/bootstrap.min.js"></script>
    <script src="~/ovioadmin/dist/js/ovio.js"></script>
</body>
</html>