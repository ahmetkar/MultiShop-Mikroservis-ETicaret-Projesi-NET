@model ResultAboutDto

<!-- Footer Start -->
<div class="container-fluid bg-dark text-secondary mt-5 pt-5">
    <div class="row px-xl-5 pt-5">
        <div class="col-lg-4 col-md-6 mb-5 pr-3 pr-xl-5">
            <h5 class="text-secondary text-uppercase mb-4">Hakkımızda</h5>
            <p class="mb-4">@(string.IsNullOrWhiteSpace(Model?.Description) ? "MultiShop kaliteli ürünleri ve güvenli alışveriş deneyimiyle her zaman yanınızda." : Model.Description)</p>
            <p class="mb-2"><i class="fa fa-map-marker-alt text-primary mr-3"></i>@(string.IsNullOrWhiteSpace(Model?.Address) ? "İstanbul, Türkiye" : Model.Address)</p>
            <p class="mb-2"><i class="fa fa-envelope text-primary mr-3"></i>@(string.IsNullOrWhiteSpace(Model?.Email) ? "info@multishop.com" : Model.Email)</p>
            <p class="mb-0"><i class="fa fa-phone-alt text-primary mr-3"></i>@(string.IsNullOrWhiteSpace(Model?.Phone) ? "+90 212 000 00 00" : Model.Phone)</p>
        </div>
        
        <div class="col-lg-4 col-md-6 mb-5">
            <h5 class="text-secondary text-uppercase mb-4">Hızlı Menü</h5>
            <div class="d-flex flex-column justify-content-start">
                <a class="text-secondary mb-2" href="/Default/Index"><i class="fa fa-angle-right mr-2"></i>Ana Sayfa</a>
                <a class="text-secondary mb-2" href="/ProductList/Index"><i class="fa fa-angle-right mr-2"></i>Tüm Ürünler</a>
                <a class="text-secondary mb-2" href="/ProductList/Campaign"><i class="fa fa-angle-right mr-2"></i>Kampanyalar & Fırsatlar</a>
                <a class="text-secondary mb-2" href="/ShoppingCart/Index"><i class="fa fa-angle-right mr-2"></i>Sepetim</a>
                <a class="text-secondary" href="/Contact/Index"><i class="fa fa-angle-right mr-2"></i>İletişim</a>
            </div>
        </div>

        <div class="col-lg-4 col-md-12 mb-5">
            <h5 class="text-secondary text-uppercase mb-4">Hesap & İşlemler</h5>
            <div class="d-flex flex-column justify-content-start">
                @if (User.Identity.IsAuthenticated)
                {
                    <a class="text-secondary mb-2" href="/UserProfile/Index"><i class="fa fa-angle-right mr-2"></i>Profilim</a>
                    <a class="text-secondary mb-2" href="/UserProfile/Index"><i class="fa fa-angle-right mr-2"></i>Siparişlerim</a>
                    <a class="text-secondary mb-2" href="/ShoppingCart/Index"><i class="fa fa-angle-right mr-2"></i>Sepetim</a>
                    <a class="text-secondary mb-2" href="/Auth/Logout"><i class="fa fa-angle-right mr-2"></i>Çıkış Yap</a>
                }
                else
                {
                    <a class="text-secondary mb-2" href="/ShoppingCart/Index"><i class="fa fa-angle-right mr-2"></i>Sepetim</a>
                    <a class="text-secondary mb-2" href="/Auth/Login"><i class="fa fa-angle-right mr-2"></i>Giriş Yap</a>
                    <a class="text-secondary mb-2" href="/Register/Index"><i class="fa fa-angle-right mr-2"></i>Kayıt Ol</a>
                }
            </div>
            <h6 class="text-secondary text-uppercase mt-4 mb-3">Bizi Takip Edin</h6>
            <div class="d-flex">
                <a class="btn btn-primary btn-square mr-2" href="#"><i class="fab fa-twitter"></i></a>
                <a class="btn btn-primary btn-square mr-2" href="#"><i class="fab fa-facebook-f"></i></a>
                <a class="btn btn-primary btn-square mr-2" href="#"><i class="fab fa-linkedin-in"></i></a>
                <a class="btn btn-primary btn-square" href="#"><i class="fab fa-instagram"></i></a>
            </div>
        </div>
    </div>
    <div class="row border-top mx-xl-5 py-4" style="border-color: rgba(256, 256, 256, .1) !important;">
        <div class="col-md-6 px-xl-0">
            <p class="mb-md-0 text-center text-md-left text-secondary">
                &copy; @DateTime.Now.Year <a class="text-primary" href="/Default/Index">MultiShop</a>. Tüm Hakları Saklıdır.
            </p>
        </div>
        <div class="col-md-6 px-xl-0 text-center text-md-right">
            <img class="img-fluid" src="~/multishop/img/payments.png" alt="Ödeme Seçenekleri">
        </div>
    </div>
</div>
<!-- Footer End -->
