@model BasketTotalDto
<div class="col-lg-8 table-responsive mb-5">
    <table class="table table-light table-borderless table-hover text-center mb-0">
        <thead class="thead-dark">
            <tr>
                <th>Ürün</th>
                <th>Fiyat</th>
                <th>Miktar</th>
                <th>Toplam</th>
                <th>Kaldır</th>
            </tr>
        </thead>
        <tbody class="align-middle">
            @if (Model != null && Model.BasketItems != null && Model.BasketItems.Count > 0)
            {
                @foreach (var item in Model.BasketItems)
                {
                    var encodedFilter = Uri.EscapeDataString(item.SelectedFilter ?? "");
                    <tr>
                        <td class="align-middle text-left" style="min-width: 200px;">
                            <img src="@item.ProductImageUrl" alt="@item.ProductName" style="width: 50px; height: 60px; object-fit: cover; margin-right: 10px;">
                            <strong>@item.ProductName</strong>
                            @if (!string.IsNullOrEmpty(item.SelectedFilter))
                            {
                                <br />
                                <span class="badge badge-info" style="font-size: 11px; background-color: #17a2b8; color: #fff; margin-top: 4px; padding: 3px 6px;">
                                    <i class="fa fa-tags"></i> @item.SelectedFilter
                                </span>
                            }
                        </td>
                        <td class="align-middle">₺@item.Price.ToString("N2")</td>
                        <td class="align-middle">
                            <div class="input-group quantity mx-auto" style="width: 100px;">
                                <div class="input-group-btn">
                                    <a href="/ShoppingCart/DecrementBasketItem?id=@item.ProductId&selectedFilter=@encodedFilter" class="btn btn-sm btn-primary btn-minus">
                                        <i class="fa fa-minus"></i>
                                    </a>
                                </div>
                                <input type="text" class="form-control form-control-sm bg-secondary border-0 text-center" value="@item.Quantity" readonly>
                                <div class="input-group-btn">
                                    <a href="/ShoppingCart/AddBasketItem?id=@item.ProductId&selectedFilter=@encodedFilter" class="btn btn-sm btn-primary btn-plus">
                                        <i class="fa fa-plus"></i>
                                    </a>
                                </div>
                            </div>
                        </td>
                        <td class="align-middle font-weight-bold">₺@((item.Price * item.Quantity).ToString("N2"))</td>
                        <td class="align-middle">
                            <a href="/ShoppingCart/RemoveBasketItem?id=@item.ProductId&selectedFilter=@encodedFilter" class="btn btn-sm btn-danger" onclick="return confirm('Bu ürünü sepetten çıkarmak istediğinize emin misiniz?');">
                                <i class="fa fa-times"></i>
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center py-4">
                        <i class="fa fa-shopping-cart fa-3x text-muted mb-3 d-block"></i>
                        <h5>Sepetinizde ürün bulunmamaktadır.</h5>
                        <a href="/" class="btn btn-primary mt-2">Alışverişe Başla</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model != null && Model.BasketItems != null && Model.BasketItems.Count > 0)
    {
        <form asp-controller="ShoppingCart" asp-action="DeleteBasket" method="post">
            <button type="submit" class="btn btn-block btn-outline-danger font-weight-bold my-3 py-2" onclick="return confirm('Sepetteki tüm ürünleri temizlemek istediğinize emin misiniz?');">
                <i class="fa fa-trash mr-1"></i> Sepeti Temizle
            </button>
        </form>
    }
</div>
