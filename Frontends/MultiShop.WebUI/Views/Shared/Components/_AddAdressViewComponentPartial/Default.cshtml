@using MultiShop.DtoLayer.OrderDtos.OrderAddressDtos
@model CreateAdressViewModel

<form method="post" asp-action="CreateAdress" asp-controller="Order">
    
<div class="col-lg-8">

    <h6>Hiç adres bilginiz olmadığından siparişi tamamlayabilmek için adres eklemek zorundasınız.</h6>

    <h5 class="section-title position-relative text-uppercase mb-3"><span class="bg-secondary pr-3">Fatura Adresi</span></h5>
    
    <div class="bg-light p-30 mb-5">
      

            <div class="row">
                <div class="col-md-6 form-group">
                    <label>Adınız</label>
                    <input class="form-control" type="text" placeholder="Adınız" asp-for="Billing.Name">
                </div>
                <div class="col-md-6 form-group">
                    <label>Soyadınız</label>
                    <input class="form-control" type="text" placeholder="Soyadınız" asp-for="Billing.Surname">
                </div>
                <div class="col-md-6 form-group">
                    <label>E-mail Adresiniz</label>
                    <input class="form-control" type="text" placeholder="E-mail Adresiniz" asp-for="Billing.Email">
                </div>
                <div class="col-md-6 form-group">
                    <label>Telefon</label>
                    <input class="form-control" type="text" placeholder="Telefon" asp-for="Billing.Phone">
                </div>
                <div class="col-md-6 form-group">
                    <label>Adres Satır 1</label>
                    <input class="form-control" type="text" placeholder="1.adres" asp-for="Billing.Detail1">
                </div>
                <div class="col-md-6 form-group">
                    <label>Adres Satır 2</label>
                    <input class="form-control" type="text" placeholder="2.adres" asp-for="Billing.Detail2">
                </div>
                <div class="col-md-6 form-group">
                    <label>Country</label>
                    <input class="form-control" type="text" placeholder="Ülke" asp-for="Billing.Country">
                </div>
                <div class="col-md-6 form-group">
                    <label>Şehir</label>
                    <input class="form-control" type="text" placeholder="Konya" asp-for="Billing.City">
                </div>
                <div class="col-md-6 form-group">
                    <label>İlçe</label>
                    <input class="form-control" type="text" placeholder="Meram" asp-for="Billing.District">
                </div>
                <div class="col-md-6 form-group">
                    <label>Posta Kodu</label>
                    <input class="form-control" type="text" placeholder="Posta Kodu" asp-for="Billing.ZipCode">
                </div>
                <div class="col-md-12 form-group">
                    <label>Adres Açıklaması</label>
                    <input class="form-control" type="text" placeholder="Adres Açıklaması" asp-for="Billing.Description">
                </div>
                <div class="col-md-12">
                    <div class="custom-control custom-checkbox">
                        <input type="checkbox" class="custom-control-input" asp-for="IsShippingExists" id="shipto">
                        <label class="custom-control-label" for="shipto" data-toggle="collapse" data-target="#shipping-address">Kargo adresi farklı olsun</label>
                    </div>
                </div>
            </div>
       



        <div class="collapse mb-5" id="shipping-address">
            <h5 class="section-title position-relative text-uppercase mb-3"><span class="bg-secondary pr-3">Kargo Adresi</span></h5>
      
                <div class="bg-light p-30">
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label>Adınız</label>
                            <input class="form-control" type="text" placeholder="Adınız" asp-for="Shipping.Name">
                        </div>
                        <div class="col-md-6 form-group">
                            <label>Soyadınız</label>
                            <input class="form-control" type="text" placeholder="Soyadınız" asp-for="Shipping.Surname">
                        </div>
                        <div class="col-md-6 form-group">
                            <label>E-mail Adresiniz</label>
                            <input class="form-control" type="text" placeholder="E-mail Adresiniz" asp-for="Shipping.Email">
                        </div>
                        <div class="col-md-6 form-group">
                            <label>Telefon</label>
                            <input class="form-control" type="text" placeholder="Telefon" asp-for="Shipping.Phone">
                        </div>
                        <div class="col-md-6 form-group">
                            <label>Adres Satır 1</label>
                            <input class="form-control" type="text" placeholder="1.adres" asp-for="Shipping.Detail1">
                        </div>
                        <div class="col-md-6 form-group">
                            <label>Adres Satır 2</label>
                            <input class="form-control" type="text" placeholder="2.adres" asp-for="Shipping.Detail2">
                        </div>
                        <div class="col-md-6 form-group">
                            <label>Country</label>
                            <input class="form-control" type="text" placeholder="Ülke" asp-for="Shipping.Country">
                        </div>
                        <div class="col-md-6 form-group">
                            <label>Şehir</label>
                            <input class="form-control" type="text" placeholder="Konya" asp-for="Shipping.City">
                        </div>
                        <div class="col-md-6 form-group">
                            <label>İlçe</label>
                            <input class="form-control" type="text" placeholder="Meram" asp-for="Shipping.District">
                        </div>
                        <div class="col-md-6 form-group">
                            <label>Posta Kodu</label>
                            <input class="form-control" type="text" placeholder="Posta Kodu" asp-for="Shipping.ZipCode">
                        </div>
                        <div class="col-md-12 form-group">
                            <label>Adres Açıklaması</label>
                            <input class="form-control" type="text" placeholder="Adres Açıklaması" asp-for="Shipping.Description">
                        </div>
                    </div>
                </div>
           
        </div>
        
    </div>
       
 
</div>
    <div class="col-lg-4">
        <div class="mb-5">
            <div class="bg-light p-30">
                <button type="submit" class="btn btn-block btn-primary font-weight-bold py-3" type="submit">Adresi Ekle</button>
            </div>
        </div>

    </div>
</form>