
@model List<ResultProductFilterDto>
@{
    var groupedFilters = Model.GroupBy(x => x.FilterTitle).ToList();
    var selectedFilterIds = ViewBag.SelectedFilterIds as List<string> ?? new List<string>();
    var categoryId = ViewBag.CategoryId as string ?? "";
}

<form id="filterForm" method="get" action="/ProductList/Index/@categoryId">
    <input type="hidden" name="id" value="@categoryId" />

    @if (groupedFilters != null && groupedFilters.Count > 0)
    {
        @foreach (var group in groupedFilters)
        {
            <h5 class="section-title position-relative text-uppercase mb-3">
                <span class="bg-secondary pr-3">@group.Key</span>
            </h5>
            <div class="bg-light p-4 mb-30" style="border-radius: 4px;">
                @foreach (var filter in group)
                {
                    var isChecked = selectedFilterIds.Contains(filter.FilterId);
                    var inputId = "chk_" + filter.FilterId;
                    <div class="custom-control custom-checkbox d-flex align-items-center justify-content-between mb-3">
                        <input type="checkbox" class="custom-control-input" id="@inputId" name="filterIds" value="@filter.FilterId" @(isChecked ? "checked" : "")>
                        <label class="custom-control-label" for="@inputId">@filter.FilterName</label>
                    </div>
                }
            </div>
        }

        <div class="mb-4">
            <button type="submit" class="btn btn-primary btn-block font-weight-bold py-2 mb-2">
                <i class="fa fa-filter mr-1"></i> Filtreleri Uygula
            </button>
            @if (selectedFilterIds.Count > 0)
            {
                <a href="/ProductList/Index/@categoryId" class="btn btn-outline-secondary btn-block py-2">
                    <i class="fa fa-times mr-1"></i> Filtreleri Temizle
                </a>
            }
        </div>
    }
    else
    {
        <div class="bg-light p-4 mb-30 text-center text-muted" style="border-radius: 4px;">
            <i class="fa fa-info-circle mb-2" style="font-size:24px;"></i>
            <p class="mb-0">Bu kategori için tanımlı filtre bulunmamaktadır.</p>
        </div>
    }
</form>
