@model List<ResultOfferDiscountDto>

<!-- Offer Start -->
<div class="container-fluid pt-5 pb-3">
    <div class="row px-xl-5">

        @foreach(var item in Model){
            <div class="col-md-6">
                <div class="product-offer mb-30 position-relative" style="height: 300px;">
                    <img class="img-fluid" src="@item.ImageUrl" alt="@item.Title" style="object-fit: cover; width: 100%; height: 100%;">
                    <div class="offer-text">
                        <h6 class="text-white text-uppercase">@item.Title</h6>
                        <h3 class="text-white mb-3">@item.Subtitle</h3>
                        <a href="/ProductList/Campaign?type=offer&id=@item.OfferDiscountId" class="btn btn-primary font-weight-bold">@(!string.IsNullOrEmpty(item.ButtonTitle) ? item.ButtonTitle : "İncele")</a>
                    </div>
                </div>
            </div>
        }

    </div>
</div>
<!-- Offer End -->
