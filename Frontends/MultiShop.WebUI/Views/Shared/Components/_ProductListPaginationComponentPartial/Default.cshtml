@{
    var categoryId = ViewBag.CategoryId as string ?? "";
    var filterIds = ViewBag.FilterIds as List<string> ?? new List<string>();
    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var totalPages = ViewBag.TotalPages as int? ?? 1;

    string BuildUrl(int p)
    {
        var url = $"/ProductList/Index/{categoryId}?id={categoryId}&page={p}";
        foreach (var fId in filterIds)
        {
            url += $"&filterIds={fId}";
        }
        return url;
    }
}

@if (totalPages > 1)
{
    <div class="col-12">
        <nav>
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <a class="page-link" href="@BuildUrl(currentPage - 1)">Önceki</a>
                </li>
                @for (int p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p == currentPage ? "active" : "")">
                        <a class="page-link" href="@BuildUrl(p)">@p</a>
                    </li>
                }
                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                    <a class="page-link" href="@BuildUrl(currentPage + 1)">Sonraki</a>
                </li>
            </ul>
        </nav>
    </div>
}