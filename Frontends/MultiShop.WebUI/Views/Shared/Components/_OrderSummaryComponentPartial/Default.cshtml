@model BasketTotalDto

<div class="bg-light p-30 mb-5">
    <div class="border-bottom">
        <h6 class="mb-3">Sipariş Ürün Listesi</h6>
        @foreach(var item in Model.BasketItems)
        {
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div>
                    <span class="font-weight-bold">@item.ProductName</span>
                    @if (!string.IsNullOrEmpty(item.SelectedFilter))
                    {
                        <span class="badge badge-info" style="font-size:11px; background-color:#17a2b8; color:#fff; padding:2px 5px; margin-left:4px;">@item.SelectedFilter</span>
                    }
                    <span class="text-muted ml-1">x @item.Quantity</span>
                </div>
                <h6>₺@((item.Price * item.Quantity).ToString("N2"))</h6>
            </div>
        }        
    </div>
    <div class="border-bottom pt-3 pb-2">
        <div class="d-flex justify-content-between mb-3">
            <h6>Alışveriş Tutarı (Kdv siz)</h6>
            <h6>@Model.TotalPriceWithoutKDV ₺</h6>
        </div>
        @if (Model.TotalPriceWithoutDiscount != 0)
        {
            <div class="d-flex justify-content-between mb-3">
                <h6>Alışveriş Tutarı (Kdv dahil) - İndirimsiz</h6>
            <h6>@Model.TotalPriceWithoutDiscount ₺</h6>
        </div>

            <div class="d-flex justify-content-between mb-3">
                <h6>İndirim Oranı : </h6>
                <h6>@Model.DiscountRate</h6>
            </div>
            <div class="d-flex justify-content-between mb-3">
                <h6>İndirim Kodu : </h6>
                <h6>@Model.DiscountCode</h6>
            </div>

            <div class="d-flex justify-content-between mb-3">
                <h6>Alışveriş Tutarı (Kdv dahil) - İndirimli</h6>
                <h6>@Model.TotalPrice ₺</h6>
            </div>
        }

        <div class="d-flex justify-content-between mb-3">
            <h6>KDV tutarı : </h6>
            <h6>@Model.KDVPrice ₺</h6>
        </div>

        <div class="d-flex justify-content-between">
            <h6 class="font-weight-medium">Kargo Ücreti</h6>
            <h6 class="font-weight-medium">@ViewBag.CargoPrice ₺</h6>
        </div>
    </div>
    <div class="pt-2">
        <div class="d-flex justify-content-between mt-2">
            <h5>Genel Toplam</h5>
            <h5>@(Model.TotalPrice + ViewBag.CargoPrice ) ₺</h5>
        </div>
    </div>
</div>