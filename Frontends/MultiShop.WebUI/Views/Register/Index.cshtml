@model CreateRegisterDto

@{
    ViewData["Title"] = "Kayıt Ol";
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Kayıt Ol - MultiShop</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/ovioadmin/bootstrap/css/bootstrap.min.css">

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css?family=Poppins:300,400,500,600,700" rel="stylesheet">

    <!-- Template style -->
    <link rel="stylesheet" href="~/ovioadmin/dist/css/style.css">
    <link rel="stylesheet" href="~/ovioadmin/pages/et-line-font/et-line-font.css">
    <link rel="stylesheet" href="~/ovioadmin/pages/font-awesome/css/font-awesome.min.css">
</head>

<body class="body-bg-color">
    <div class="wrapper">
        <div class="form-body">
            <form method="post" class="col-form">
                <div class="col-logo"><a href="/"><img width="300px" height="60px" alt="MultiShop Logo" src="~/img/logos/MULTISHOPPNG.png"></a></div>
                <header>Kayıt Ol</header>

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                {
                    <div asp-validation-summary="ModelOnly" class="text-danger" style="padding: 12px 15px; margin-bottom: 15px; background-color: #fff0f0; border-left: 4px solid #ff4d4d; border-radius: 4px; font-weight: 500; font-size: 13px;"></div>
                }

                <fieldset>
                    <section>
                        <p style="color: #666; font-size: 13px;">Fırsatlardan yararlanabilmek, sipariş verebilmek ve ayrıcalıklı alışveriş için hemen ücretsiz kayıt olun.</p>
                    </section>
                    <section>
                        <div class="form-group has-feedback">
                            <label class="control-label">Ad <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" placeholder="Adınız" type="text" required>
                            <span class="fa fa-user form-control-feedback" aria-hidden="true"></span>
                            <span asp-validation-for="Name" class="text-danger" style="font-size: 12px;"></span>
                        </div>
                    </section>
                    <section>
                        <div class="form-group has-feedback">
                            <label class="control-label">Soyad <span class="text-danger">*</span></label>
                            <input asp-for="Surname" class="form-control" placeholder="Soyadınız" type="text" required>
                            <span class="fa fa-user form-control-feedback" aria-hidden="true"></span>
                            <span asp-validation-for="Surname" class="text-danger" style="font-size: 12px;"></span>
                        </div>
                    </section>
                    <section>
                        <div class="form-group has-feedback">
                            <label class="control-label">Kullanıcı Adı <span class="text-danger">*</span></label>
                            <input asp-for="UserName" class="form-control" placeholder="Kullanıcı adınız" type="text" required>
                            <span class="fa fa-at form-control-feedback" aria-hidden="true"></span>
                            <span asp-validation-for="UserName" class="text-danger" style="font-size: 12px;"></span>
                        </div>
                    </section>
                    <section>
                        <div class="form-group has-feedback">
                            <label class="control-label">E-Posta Adresi <span class="text-danger">*</span></label>
                            <input asp-for="Email" class="form-control" placeholder="ornek@email.com" type="email" required>
                            <span class="fa fa-envelope form-control-feedback" aria-hidden="true"></span>
                            <span asp-validation-for="Email" class="text-danger" style="font-size: 12px;"></span>
                        </div>
                    </section>
                    <section>
                        <div class="form-group has-feedback">
                            <label class="control-label">Şifre <span class="text-danger">*</span></label>
                            <input asp-for="Password" class="form-control" placeholder="En az 6 karakter" type="password" required>
                            <span class="fa fa-lock form-control-feedback" aria-hidden="true"></span>
                            <span asp-validation-for="Password" class="text-danger" style="font-size: 12px;"></span>
                        </div>
                    </section>
                    <section>
                        <div class="form-group has-feedback">
                            <label class="control-label">Şifre Tekrar <span class="text-danger">*</span></label>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="Şifrenizi tekrar giriniz" type="password" required>
                            <span class="fa fa-lock form-control-feedback" aria-hidden="true"></span>
                            <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size: 12px;"></span>
                        </div>
                    </section>
                    <section>
                        <div class="row">
                            <div class="col-md-12 text-center">
                                <label class="checkbox">
                                    <input asp-for="Remember" checked="" type="checkbox">
                                    <i></i> Kullanım şartlarını ve gizlilik politikasını kabul ediyorum.
                                </label>
                            </div>
                        </div>
                    </section>
                </fieldset>
                <footer class="text-right">
                    <button type="submit" class="btn btn-info pull-right">Kayıt Ol</button>
                    <a href="/Auth/Login" class="button button-secondary">Giriş Yap</a>
                </footer>
            </form>
        </div>
    </div>
    <!-- wrapper -->
    <!-- jQuery -->
    <script src="~/ovioadmin/dist/js/jquery.min.js"></script>
    <script src="~/ovioadmin/bootstrap/js/bootstrap.min.js"></script>
    <script src="~/ovioadmin/dist/js/ovio.js"></script>
</body>
</html>