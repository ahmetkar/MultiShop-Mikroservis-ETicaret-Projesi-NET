@model MultiShop.Images.WebUI.DAL.Entities.ImageDrive;

@{
    ViewData["Title"] = "Edit";
    Layout = null;

}
<h1>Resim yükleme</h1>

<link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
<link href="~/lib/bootstrap/dist/css/bootstrap.rtl.css" rel="stylesheet" />
<link href="~/lib/bootstrap/dist/css/bootstrap.css" rel="stylesheet" />

<div class="container">
<form method="post" enctype="multipart/form-data">
    <label>Görsel Adı : </label>
    <input type="text" class="form-control border" name="Name" />
    <br />
    <label>Dosya Seçin : </label>
    <input type="file" class="form-control border" name="Photo" />
    <br />

    <input name="SavedUrl" type="hidden" class="form-control" />
    <input name="SavedFileName" type="hidden" class="form-control" />
    <button class="btn btn-outline-info">Görseli Kaydet</button>

</form>

</div>