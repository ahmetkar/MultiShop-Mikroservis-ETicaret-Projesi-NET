@model MultiShop.RapidApi.Models.ProductViewModel


<div class="container">

    @foreach(var i in Model.data.products)
    {
        <h1>Ürün başlık :</h1>
        <a href="@i.product_offer_page_url">
        @i.product_title
        </a>
        <br />
        <h1>Ürün Fiyat:</h1>
        <br />
        @i.price
        <h1>Ürün rating :</h1><br />
        @i.product_rating

        <br /><br />
    }

</div>